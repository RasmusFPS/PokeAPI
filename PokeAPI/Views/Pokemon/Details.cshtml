@model PokeAPI.Models.Pokemon

<div class="container py-4">
    @if (Model == null)
    {
        <div class="text-center text-white py-5">
            <h2>Kunde inte hitta pokemonen!</h2>
            <a asp-action="Index" class="btn btn-outline-light mt-3">Tillbaka till sökning</a>
        </div>
    }
    else
    {
        <div class="card bg-dark text-white border-secondary shadow mx-auto text-center" style="max-width: 380px;">
            <div class="card-body p-4">

                <h2 class="card-title text-capitalize mb-3">@Model.Name</h2>

                @if (Model.Sprites != null && !string.IsNullOrEmpty(Model.Sprites.FrontDefault))
                {
                    <div class="d-flex justify-content-center align-items-center mb-3" style="height: 160px;">
                        <img src="@Model.Sprites.FrontDefault"
                             alt="@Model.Name"
                             style="width: 150px; height: 150px; object-fit: contain; image-rendering: pixelated;" />
                    </div>
                }

                <hr class="border-secondary my-3" />

                <h4 class="mb-3">Stats</h4>

                <ul class="list-group list-group-flush mb-4 rounded">
                    @foreach (var stat in Model.Stats)
                    {
                        <li class="list-group-item bg-transparent text-white border-secondary d-flex justify-content-between align-items-center px-2 py-1">
                            <span class="text-capitalize text-secondary">@stat.Stat.Name</span>
                            <span class="badge bg-info text-dark fw-bold">@stat.BaseStat</span>
                        </li>
                    }
                </ul>

                <a asp-action="Index" class="btn btn-outline-info w-100">
                    Tillbaka till sökning
                </a>

            </div>
        </div>
    }
</div>