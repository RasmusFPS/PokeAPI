@{
    ViewData["Title"] = "Pokemon Page";
}

@model List<PokeAPI.Models.Pokemon>

<h1>All 1300 Pokémon!</h1>

@if (Model == null)
{
    <p style="color:red">Failed to load Pokemon.</p>
}
else
{
    <ul>
        @foreach (var pokemon in Model)
        {
            <li>@pokemon.Name</li>
        }
    </ul>
}